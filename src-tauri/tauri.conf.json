{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultrasongs",
  "version": "0.1.0",
  "identifier": "com.ultrasongs.app",
  "build": {
    "frontendDist": "../tauri-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ultrasongs",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../.next-standalone/bundle": "app",
      "../python/transcribe_service.py": "python/transcribe_service.py",
      "../python/whisperx_worker.py": "python/whisperx_worker.py",
      "../python/download_models.py": "python/download_models.py",
      "../python/hf_compat.py": "python/hf_compat.py",
      "../python/requirements.lock.txt": "python/requirements.lock.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
