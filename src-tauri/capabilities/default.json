{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window permissions, including the local Next.js server the shell navigates to.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-check-update",
    "allow-install-update",
    "allow-open-external",
    "allow-save-download"
  ]
}
