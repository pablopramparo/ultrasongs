# Copy to .env.local. Every value is optional; the defaults work out of the box.

# Python transcription service
PYTHON_SERVICE_URL=http://localhost:8001

# Working folders (relative paths resolve from the project root)
TMP_DIR=./tmp
# DRAFTS_DIR=./drafts

# Your Ultrastar "Songs" folder. Finished songs are also written here, and the library lists it.
# Can also be chosen from Settings in the app; setting it here locks that control.
# SONGS_DIR=D:\Ultrastar\Songs

# Alignment engine: whisperx (forced alignment, recommended) or whisper
ALIGN_ENGINE=whisperx

# Whisper model: small is quick; medium is a good balance on a GPU; large-v3 needs lots of VRAM
WHISPERX_MODEL=medium
# WHISPER_MODEL=medium            # used when ALIGN_ENGINE=whisper

# Cleaner vocals at ~4x the time:
# DEMUCS_MODEL=htdemucs_ft

# Remove the YouTube downloader (build time)
# NEXT_PUBLIC_ENABLE_YOUTUBE=0
