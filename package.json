{
  "name": "ultrasongs",
  "version": "0.3.13",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names \"next,python\" --prefix-colors \"cyan,yellow\" \"pnpm dev\" \"node scripts/ensure-python.mjs\"",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently --names \"next,python\" --prefix-colors \"cyan,yellow\" \"next start -H 0.0.0.0 -p 3010\" \"node scripts/ensure-python.mjs\"",
    "lint": "eslint",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:build": "node scripts/prepare-tauri.mjs && node scripts/tauri-build.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.1",
    "music-tempo": "^1.0.3",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
